# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server Port
PORT=3000

# Node Environment ('development' | 'production')
NODE_ENV="development"

# JWT Secret for Session Cookies
JWT_SECRET="certichain-secure-jwt-secret-key-32chars-min-university-grade"

# Blockchain Configuration
# For local devnet, an in-process Ganache / EVM provider runs automatically.
# To connect to external Hardhat node or Sepolia testnet, configure below:
BLOCKCHAIN_RPC_URL="http://127.0.0.1:8545"
BLOCKCHAIN_NETWORK="Local Devnet (Chain ID: 31337)"
DEPLOYER_PRIVATE_KEY="0x4f3edf983ac636a65a842ce7c78d9aa706d3b113bce9c46f30d7d21715b23b1d"
ISSUER_PRIVATE_KEY="0x6cbed15c793ce57650b9877cf26f5d7d95718e54388cda9765fe75ec57df7e3e"
