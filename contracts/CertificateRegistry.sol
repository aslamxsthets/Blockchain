pragma solidity ^0.8.20;

/**
 * @title CertificateRegistry
 * @dev Cryptographic registry for tamper-evident university academic credentials.
 * Anchors certificate fingerprints (SHA-256) on-chain without storing personal information.
 */
contract CertificateRegistry {
    // Custom Errors
    error NotOwner();
    error NotAuthorizedIssuer();
    error CertificateAlreadyExists(string certificateId);
    error CertificateDoesNotExist(string certificateId);
    error CertificateAlreadyRevoked(string certificateId);
    error InvalidFingerprint();
    error InvalidIssuerAddress();
    error EmptyCertificateId();
    error EmptyReason();

    // Data Structures
    struct CertificateRecord {
        bytes32 fingerprint;      // SHA-256 hash of canonical certificate data
        address issuerAddress;    // Ethereum address of the issuing institution
        string issuerId;          // Canonical institution identifier (e.g. "INST-STANFORD-001")
        uint64 issuedAt;          // Timestamp of blockchain anchoring
        uint64 blockNumber;       // Block number of anchoring
        bool exists;              // Existence flag
        bool isRevoked;           // Revocation state flag
        uint64 revokedAt;         // Timestamp of revocation
        string revocationReason;  // Human-readable reason or reason code
    }

    // State Variables
    address public owner;
    mapping(address => bool) public authorizedIssuers;
    mapping(string => CertificateRecord) private certificates;
    string[] private certificateIds;

    // Events
    event IssuerAuthorized(address indexed issuerAddress, string issuerId, address indexed authorizedBy);
    event IssuerRevoked(address indexed issuerAddress, address indexed revokedBy);
    event CertificateIssued(
        string indexed certificateId,
        bytes32 indexed fingerprint,
        address indexed issuerAddress,
        string issuerId,
        uint64 issuedAt
    );
    event CertificateRevoked(
        string indexed certificateId,
        address indexed revokedBy,
        uint64 revokedAt,
        string reason
    );

    // Modifiers
    modifier onlyOwner() {
        if (msg.sender != owner) revert NotOwner();
        _;
    }

    modifier onlyAuthorizedIssuer() {
        if (msg.sender != owner && !authorizedIssuers[msg.sender]) {
            revert NotAuthorizedIssuer();
        }
        _;
    }

    constructor() {
        owner = msg.sender;
        authorizedIssuers[msg.sender] = true;
        emit IssuerAuthorized(msg.sender, "PRIMARY-ADMIN", msg.sender);
    }

    /**
     * @notice Authorize an institution address to issue credentials
     */
    function authorizeIssuer(address issuerAddress, string calldata issuerId) external onlyOwner {
        if (issuerAddress == address(0)) revert InvalidIssuerAddress();
        authorizedIssuers[issuerAddress] = true;
        emit IssuerAuthorized(issuerAddress, issuerId, msg.sender);
    }

    /**
     * @notice Revoke issuer authorization
     */
    function deauthorizeIssuer(address issuerAddress) external onlyOwner {
        if (issuerAddress == address(0)) revert InvalidIssuerAddress();
        authorizedIssuers[issuerAddress] = false;
        emit IssuerRevoked(issuerAddress, msg.sender);
    }

    /**
     * @notice Check whether an address is an authorized issuer
     */
    function isAuthorizedIssuer(address issuerAddress) external view returns (bool) {
        return authorizedIssuers[issuerAddress] || issuerAddress == owner;
    }

    /**
     * @notice Register a tamper-evident certificate fingerprint on-chain
     * @param certificateId Unique identifier generated by university
     * @param fingerprint 32-byte SHA-256 hash of canonical certificate representation
     * @param issuerId University or department identifier
     */
    function registerCertificate(
        string calldata certificateId,
        bytes32 fingerprint,
        string calldata issuerId
    ) external onlyAuthorizedIssuer {
        if (bytes(certificateId).length == 0) revert EmptyCertificateId();
        if (fingerprint == bytes32(0)) revert InvalidFingerprint();
        if (certificates[certificateId].exists) revert CertificateAlreadyExists(certificateId);

        certificates[certificateId] = CertificateRecord({
            fingerprint: fingerprint,
            issuerAddress: msg.sender,
            issuerId: issuerId,
            issuedAt: uint64(block.timestamp),
            blockNumber: uint64(block.number),
            exists: true,
            isRevoked: false,
            revokedAt: 0,
            revocationReason: ""
        });

        certificateIds.push(certificateId);

        emit CertificateIssued(
            certificateId,
            fingerprint,
            msg.sender,
            issuerId,
            uint64(block.timestamp)
        );
    }

    /**
     * @notice Revoke an issued certificate with a mandatory reason
     * @param certificateId The certificate identifier to revoke
     * @param reason The official revocation reason
     */
    function revokeCertificate(
        string calldata certificateId,
        string calldata reason
    ) external onlyAuthorizedIssuer {
        if (bytes(certificateId).length == 0) revert EmptyCertificateId();
        if (bytes(reason).length == 0) revert EmptyReason();

        CertificateRecord storage record = certificates[certificateId];
        if (!record.exists) revert CertificateDoesNotExist(certificateId);
        if (record.isRevoked) revert CertificateAlreadyRevoked(certificateId);

        record.isRevoked = true;
        record.revokedAt = uint64(block.timestamp);
        record.revocationReason = reason;

        emit CertificateRevoked(
            certificateId,
            msg.sender,
            uint64(block.timestamp),
            reason
        );
    }

    /**
     * @notice Check if a certificate exists in the registry
     */
    function certificateExists(string calldata certificateId) external view returns (bool) {
        return certificates[certificateId].exists;
    }

    /**
     * @notice Verify a certificate fingerprint against the on-chain anchor
     * @param certificateId Unique certificate identifier
     * @param candidateFingerprint Candidate SHA-256 fingerprint computed from canonical data
     * @return isValid True if certificate exists, fingerprint matches exactly, and is not revoked
     * @return isRevoked True if certificate has been revoked
     * @return registeredFingerprint The registered 32-byte fingerprint
     * @return issuerAddress The address that registered the credential
     */
    function verifyCertificate(
        string calldata certificateId,
        bytes32 candidateFingerprint
    ) external view returns (
        bool isValid,
        bool isRevoked,
        bytes32 registeredFingerprint,
        address issuerAddress
    ) {
        CertificateRecord memory record = certificates[certificateId];
        if (!record.exists) {
            return (false, false, bytes32(0), address(0));
        }

        bool matchFingerprint = (record.fingerprint == candidateFingerprint);
        bool valid = matchFingerprint && !record.isRevoked;

        return (
            valid,
            record.isRevoked,
            record.fingerprint,
            record.issuerAddress
        );
    }

    /**
     * @notice Retrieve full public proof details for an issued certificate
     */
    function getCertificate(string calldata certificateId) external view returns (
        bytes32 fingerprint,
        address issuerAddress,
        string memory issuerId,
        uint64 issuedAt,
        uint64 blockNumber,
        bool exists,
        bool isRevoked,
        uint64 revokedAt,
        string memory revocationReason
    ) {
        CertificateRecord memory record = certificates[certificateId];
        if (!record.exists) revert CertificateDoesNotExist(certificateId);

        return (
            record.fingerprint,
            record.issuerAddress,
            record.issuerId,
            record.issuedAt,
            record.blockNumber,
            record.exists,
            record.isRevoked,
            record.revokedAt,
            record.revocationReason
        );
    }

    /**
     * @notice Return total count of anchored certificates
     */
    function totalCertificates() external view returns (uint256) {
        return certificateIds.length;
    }
}
